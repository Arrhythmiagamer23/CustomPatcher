{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"version": "v1.0.0",
	"id": "roadhogstudios.custom_patcher",
	"name": "Custom Patcher",
	"developers": [ "zGuschin", "RoadHogStudios", "lil2kki" ],
	"description": "Change count of Fonts, Grounds, BGs, MGs in Geometry Dash 2.208",
	"early-load": true,
	"links": {
		"source": "https://github.com/Arrhythmiagamer23/CustomPatcher"
	},
	"dependencies": {
        "geode.node-ids": {
			"version": ">=v1.23.3",
			"required": false
		},
		"raydeeux.pages_api": {
			"version":">=1.4.16-beta.1",
			"required": false
		}
	},
	"settings": {
		"Fonts": {
			"name": "                  Fonts",
			"description": "max count of",
			"type": "int",
			"max": 999,
			"default": 59,
			"control": { "slider": false }
		},
		"Backgrounds": {
			"name": "             Backgrounds",
			"description": "max count of",
			"type": "int",
			"max": 999,
			"default": 59,
			"control": { "slider": false }
		},
		"Grounds": {
			"name": "                 Grounds",
			"description": "max count of",
			"type": "int",
			"max": 999,
			"default": 22,
			"control": { "slider": false }
		},
		"MiddleGrounds": {
			"name": "          Middle Grounds",
			"description": "max count of",
			"type": "int",
			"max": 999,
			"default": 3,
			"control": { "slider": false }
		},
		"LoadingLayerBackground": {
			"name": " LoadingLayer Background",
			"description": "id of",
			"type": "int",
			"max": 999,
			"default": 1,
			"control": { "slider": false }
		}
	}
}
